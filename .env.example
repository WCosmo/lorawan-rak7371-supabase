# =============================================================================
# CONFIGURAÇÕES OBRIGATÓRIAS - PREENCHA ANTES DE SUBIR
# =============================================================================

# --- Gateway LoRaWAN ---
# EUI do seu RAK7371 (descubra com: docker compose -f packet-forwarder/docker-compose.yml run --rm udp-packet-forwarder find_concentrator)
GATEWAY_EUI=YOUR_GATEWAY_EUI_HERE

# --- Supabase ---
# URL do seu projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Service Role Key (encontre em: Project Settings → API → service_role key)
# ATENÇÃO: NUNCA exponha esta chave no frontend!
SUPABASE_KEY=your-service-role-key-here

# =============================================================================
# CONFIGURAÇÕES OPCIONAIS (geralmente não precisa alterar)
# =============================================================================

# ChirpStack API Secret (gerar com: openssl rand -base64 32)
# Se deixar em branco, o docker-compose gera uma automaticamente na primeira execução
CHIRPSTACK_SECRET=

# Região LoRaWAN (padrão: AU915 para Brasil/ANATEL)
# Opções: au915_0, us915_0, eu868, as923, etc.
LORAWAN_REGION=au915_0
